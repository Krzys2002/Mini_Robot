{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "desktop",
      "displayName": "Desktop app only (native host toolchain)",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "MICRO_ROBOT_BUILD_DESKTOP": "ON",
        "MICRO_ROBOT_BUILD_REPLAY": "ON"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (Apple Clang, Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux (GCC, Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux (Clang, Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows (MSVC, Release)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MICRO_ROBOT_CAMERA_BACKEND": "Qt"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "core",
      "displayName": "Core only, no Qt or OpenCV (default compiler, Debug)",
      "inherits": "base",
      "cacheVariables": {
        "MICRO_ROBOT_BUILD_DESKTOP": "OFF",
        "MICRO_ROBOT_BUILD_BLE": "OFF",
        "MICRO_ROBOT_BUILD_REPLAY": "OFF",
        "MICRO_ROBOT_BUILD_VISION": "OFF",
        "MICRO_ROBOT_BUILD_CALIBRATION": "OFF",
        "MICRO_ROBOT_BUILD_MARKER_TOOLS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "targets": ["micro_robot_desktop"]
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "core",
      "configurePreset": "core"
    }
  ],
  "testPresets": [
    {
      "name": "test-defaults",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "exclude": {
          "label": "hardware"
        }
      }
    },
    {
      "name": "macos",
      "inherits": "test-defaults",
      "configurePreset": "macos"
    },
    {
      "name": "linux-gcc",
      "inherits": "test-defaults",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-clang",
      "inherits": "test-defaults",
      "configurePreset": "linux-clang"
    },
    {
      "name": "windows-msvc",
      "inherits": "test-defaults",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "core",
      "inherits": "test-defaults",
      "configurePreset": "core"
    }
  ]
}
