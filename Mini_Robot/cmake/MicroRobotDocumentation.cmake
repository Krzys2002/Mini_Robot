# Build-local documentation from the configured target graph. No generated
# inventory is committed, and ordinary builds do not require Python.
include_guard(GLOBAL)

function(_micro_robot_documentation_targets directory output)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        _micro_robot_documentation_targets("${child}" nested)
        list(APPEND targets ${nested})
    endforeach()
    set(${output} "${targets}" PARENT_SCOPE)
endfunction()

function(_micro_robot_documentation_literal value output)
    # Keep reports relocatable, including paths embedded in generator expressions.
    string(REPLACE "${PROJECT_BINARY_DIR}/" "@build/" value "${value}")
    string(REPLACE "${PROJECT_SOURCE_DIR}/" "@source/" value "${value}")
    if(IS_ABSOLUTE "${value}")
        get_filename_component(value "${value}" NAME)
        set(value "@external/${value}")
    endif()
    string(REPLACE "`" "&#96;" value "${value}")
    string(REPLACE "|" "&#124;" value "${value}")
    set(${output} "`${value}`" PARENT_SCOPE)
endfunction()

function(micro_robot_add_documentation)
    find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
    set(report_dir "${PROJECT_BINARY_DIR}/docs")
    set(report "${report_dir}/source-map.md")
    file(MAKE_DIRECTORY "${report_dir}")
    set(content "# Configured source and target inventory\n\n")
    string(APPEND content "Generated from CMake target properties; do not commit this file.\n\n")
    string(APPEND content "Only targets enabled in this build are shown. Sources are declared sources,\nnot a scan of every file. Dependencies below are direct LINK_LIBRARIES and\nINTERFACE_LINK_LIBRARIES declarations, including unevaluated generator expressions;\nthey are not a transitive graph or a platform-validation claim.\n\n")
    string(APPEND content "Platform: `${CMAKE_SYSTEM_NAME}`; compiler: `${CMAKE_CXX_COMPILER_ID}`; build type: `${CMAKE_BUILD_TYPE}`.\n\n## Configuration\n\n")
    get_cmake_property(options CACHE_VARIABLES)
    list(SORT options)
    foreach(option IN LISTS options)
        if(option MATCHES "^MICRO_ROBOT_")
            _micro_robot_documentation_literal("${${option}}" value)
            string(APPEND content "- `${option}`: ${value}\n")
        endif()
    endforeach()
    string(APPEND content "\n## Targets\n")
    _micro_robot_documentation_targets("${PROJECT_SOURCE_DIR}" targets)
    list(SORT targets)
    foreach(target IN LISTS targets)
        get_target_property(source_dir ${target} SOURCE_DIR)
        file(RELATIVE_PATH origin "${PROJECT_SOURCE_DIR}" "${source_dir}")
        get_target_property(type ${target} TYPE)
        # Exclude fetched dependencies, imported targets, and utility/autogen jobs.
        if(NOT origin MATCHES "^(src|tests|tools)(/|$)" OR type STREQUAL "UTILITY")
            continue()
        endif()
        string(APPEND content "\n### ${target}\n\nType: `${type}`. Declared in `${origin}/CMakeLists.txt`.\n\n")
        foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            string(APPEND content "${property}:\n\n")
            get_target_property(items ${target} ${property})
            if(items)
                foreach(item IN LISTS items)
                    _micro_robot_documentation_literal("${item}" value)
                    string(APPEND content "- ${value}\n")
                endforeach()
            else()
                string(APPEND content "- None.\n")
            endif()
            string(APPEND content "\n")
        endforeach()
        get_target_property(sources ${target} SOURCES)
        get_target_property(interface_sources ${target} INTERFACE_SOURCES)
        if(NOT sources)
            set(sources)
        endif()
        if(interface_sources)
            list(APPEND sources ${interface_sources})
        endif()
        # Include CMake header file sets as well as SOURCES/INTERFACE_SOURCES.
        foreach(property IN ITEMS HEADER_SETS INTERFACE_HEADER_SETS)
            get_target_property(sets ${target} ${property})
            if(sets)
                foreach(set IN LISTS sets)
                    get_target_property(headers ${target} HEADER_SET_${set})
                    list(APPEND sources ${headers})
                endforeach()
            endif()
        endforeach()
        list(REMOVE_DUPLICATES sources)
        list(SORT sources)
        string(APPEND content "Declared sources:\n\n")
        if(NOT sources)
            string(APPEND content "- None.\n")
        endif()
        foreach(source IN LISTS sources)
            if(NOT source MATCHES "\\$<")
                get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${source_dir}")
                file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${absolute}")
                file(RELATIVE_PATH generated "${PROJECT_BINARY_DIR}" "${absolute}")
            endif()
            if(NOT source MATCHES "\\$<" AND NOT relative MATCHES "^\\.\\./"
               AND generated MATCHES "^\\.\\./" AND EXISTS "${absolute}")
                file(RELATIVE_PATH link "${report_dir}" "${absolute}")
                foreach(pair IN ITEMS "%|%25" " |%20" "#|%23" "(|%28" ")|%29")
                    string(REPLACE "|" ";" parts "${pair}")
                    list(GET parts 0 from)
                    list(GET parts 1 to)
                    string(REPLACE "${from}" "${to}" link "${link}")
                endforeach()
                _micro_robot_documentation_literal("${relative}" label)
                string(APPEND content "- [${label}](${link})\n")
            else()
                _micro_robot_documentation_literal("${source}" label)
                string(APPEND content "- ${label} (generated, external, or unevaluated declaration)\n")
            endif()
        endforeach()
    endforeach()
    file(WRITE "${report}" "${content}")
    set(checker "${PROJECT_SOURCE_DIR}/tools/docs/check_links.py")
    add_custom_target(documentation
        COMMAND "${Python3_EXECUTABLE}" "${checker}" --root "${PROJECT_SOURCE_DIR}" --inventory "${report}"
        COMMAND "${CMAKE_COMMAND}" -E echo "Source/target inventory: ${report}"
        VERBATIM)
    if(BUILD_TESTING)
        add_test(NAME Documentation.Links
            COMMAND "${Python3_EXECUTABLE}" "${checker}" --root "${PROJECT_SOURCE_DIR}" --inventory "${report}")
        add_test(NAME Documentation.Tooling
            COMMAND "${Python3_EXECUTABLE}" -m unittest discover -s "${PROJECT_SOURCE_DIR}/tools/docs/tests" -v)
        set_tests_properties(Documentation.Links Documentation.Tooling PROPERTIES LABELS "documentation")
    endif()
endfunction()
