file(REMOVE_RECURSE "${OUTPUT}")
execute_process(COMMAND "${TOOL}" "${OUTPUT}/synthetic" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Synthetic comparison failed")
endif()
execute_process(COMMAND "${TOOL}" "${OUTPUT}/replay" "${OUTPUT}/synthetic/turning-input.csv" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "CSV replay failed")
endif()
foreach(filter exponential kalman)
    file(SHA256 "${OUTPUT}/synthetic/turning-${filter}.csv" original)
    file(SHA256 "${OUTPUT}/replay/replay-${filter}.csv" replay)
    if(NOT original STREQUAL replay)
        message(FATAL_ERROR "Replay changed ${filter} results")
    endif()
endforeach()
file(WRITE "${OUTPUT}/bad.csv" "t,x,y,heading,true_x,true_y,true_heading\n0,0,0,0,0,0,0\n")
execute_process(COMMAND "${TOOL}" "${OUTPUT}/invalid" "${OUTPUT}/bad.csv" RESULT_VARIABLE status)
if(status EQUAL 0)
    message(FATAL_ERROR "Invalid replay was accepted")
endif()
